# Comment Verdict Chrome Extension Environment Variables

# Backend API URL
# Production: https://commentverdict.com/api/v1
# Test: https://test.commentverdict.com/api/v1
# Local development: http://localhost:8000/api/v1
PLASMO_PUBLIC_API_URL=https://test.commentverdict.com/api/v1

# Web Portal URL
# Production: https://app.focus-guard.com
# Staging: https://staging.focus-guard.com
# Local development: http://localhost:3000
PLASMO_PUBLIC_WEB_PORTAL_URL=http://localhost:3000

# Debug mode (enables development mode - uses .env only, no remote config)
# Set to "1" or "true" to enable debug mode (for local development)
# Set to "0" or "false" for production builds (fetches config from remote)
# In production: Config is fetched from https://focus-guard.github.io/focus-guard-config/config.json
COMMENT_VERDICT_DEBUG=1
